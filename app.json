{
  "expo": {
    "name": "YouGo",
    "slug": "yougo",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "yougo",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ugo to access your photos so you can choose a profile picture.",
          "cameraPermission": "Allow Ugo to use your camera for profile pictures.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.yougo.app"
    },
    "ios": {
      "bundleIdentifier": "com.yougo.app",
      "supportsTablet": false
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}

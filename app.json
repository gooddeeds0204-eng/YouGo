{
  "expo": {
    "name": "YouGo",
    "slug": "yougo",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "yougo",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ugo to access your photos so you can choose a profile picture.",
          "cameraPermission": "Allow Ugo to use your camera for profile pictures.",
          "microphonePermission": false
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          },
          "ios": {
            "enableMultitaskingCameraAccess": false
          }
        }
      ],
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.yougo.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.yougo.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Ugo uses your camera when you join a video room.",
        "NSMicrophoneUsageDescription": "Ugo uses your microphone when you speak in voice or video rooms."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
